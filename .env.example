# Runtime identity. Never point preview/staging values at production resources.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Supabase server-only administration (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Transactional email and signed events
RESEND_API_KEY=replace-with-resend-api-key
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret
EMAIL_FROM=ReLoop <reloop@example.test>

# Purpose-separated operational secrets
CRON_DISPATCH_SECRET=replace-with-random-scheduler-secret
CRON_RETENTION_SECRET=replace-with-separate-retention-scheduler-secret
MONITORING_CANARY_SECRET=replace-with-separate-monitoring-canary-secret
ASSISTED_CLAIM_HMAC_SECRET=replace-with-random-claim-secret
CAPTCHA_SECRET_KEY=replace-with-captcha-secret
NEXT_PUBLIC_CAPTCHA_SITE_KEY=replace-with-captcha-site-key
ABUSE_HASH_SECRET=replace-with-random-abuse-hash-secret

# Monitoring. DSNs may be client-visible; auth tokens must remain server-only.
# SENTRY_DSN is required for the authenticated monitoring canary to return success.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
